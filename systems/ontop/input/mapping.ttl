@prefix ex: <http://example.com/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///app/datalake_vkg_api/tools/ontop/input/mappings/mapping-init.ttl#DummyMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT TABLE_NAME FROM INFORMATION_SCHEMA.\"TABLES\" WHERE 1=0" ] ;
    rr:subjectMap [ rr:class ex:Dummy ;
            rr:template "http://example.org/dummy/{TABLE_NAME}" ] .

<file:///app/datalake_vkg_api/tools/ontop/input/mappings/stations.ttl#TripleMapping_stations_1> a rr:TriplesMap ;
    rr:logicalTable [ a rr:LogicalTable ;
            rr:sqlQuery "SELECT * FROM \"garage\".\"csv\".\"stations_list.csv\"" ] ;
    rr:predicateObjectMap [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap ;
                    rr:column "stations" ;
                    rr:datatype xsd:string ] ;
            rr:predicate <http://example.com/stations/stations_list#stations> ],
        [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap ;
                    rr:column "altitude" ] ;
            rr:predicate <http://example.com/stations/stations_list#altitude> ],
        [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap ;
                    rr:column "latitude" ;
                    rr:datatype xsd:decimal ] ;
            rr:predicate <http://example.com/stations/stations_list#latitude> ],
        [ a rr:PredicateObjectMap ;
            rr:objectMap [ a rr:ObjectMap ;
                    rr:column "longitude" ;
                    rr:datatype xsd:decimal ] ;
            rr:predicate <http://example.com/stations/stations_list#longitude> ] ;
    rr:subjectMap [ a rr:SubjectMap ;
            rr:class_ <http://example.com/stations/stations_list> ;
            rr:template "row" ;
            rr:termType rr:BlankNode ] .

