@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.com/stations/stations_list#altitude> a owl:DatatypeProperty ;
    rdfs:domain <http://example.com/stations/stations_list> .

<http://example.com/stations/stations_list#latitude> a owl:DatatypeProperty ;
    rdfs:domain <http://example.com/stations/stations_list> .

<http://example.com/stations/stations_list#longitude> a owl:DatatypeProperty ;
    rdfs:domain <http://example.com/stations/stations_list> .

<http://example.com/stations/stations_list#stations> a owl:DatatypeProperty ;
    rdfs:domain <http://example.com/stations/stations_list> .

<http://example.org/ontology> a owl:Ontology .

<http://example.com/stations/stations_list> a owl:Class .

